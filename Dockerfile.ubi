# --------------------------------------------------------------------------- #
# Dockerfile.ubi — triton-sigmoid (GPU kernel library, job/CLI container)
# Base: NVIDIA CUDA 12.8 devel on UBI9 (Triton needs PTX/SASS at runtime)
# --------------------------------------------------------------------------- #
# Optimised for constrained OpenShift build environments:
#   - Combined pip install steps to lower peak disk / memory usage
#   - Single stage (devel image required at runtime for Triton JIT)
# --------------------------------------------------------------------------- #

FROM nvcr.io/nvidia/cuda:12.8.0-devel-ubi9

USER 0

# ---- System dependencies -------------------------------------------------- #
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
    && dnf clean all \
    && rm -rf /var/cache/dnf

# Ensure python3 / pip3 point to 3.12
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

WORKDIR /opt/app-root/src

# ---- Copy project source first ------------------------------------------- #
COPY . .

# ---- Install everything in one pip invocation to reduce peak disk usage --- #
# torch is installed separately because --extra-index-url applies to all
# packages in the same invocation and can cause slow/conflicting resolution.
RUN python3 -m pip install --no-cache-dir \
        "torch>=2.6.0" \
        --extra-index-url https://download.pytorch.org/whl/cu128 \
    && python3 -m pip install --no-cache-dir \
        "triton>=3.2.0" \
        . \
    && rm -rf /tmp/pip-* /root/.cache

# ---- OpenShift: group-0 permissions for arbitrary UID --------------------- #
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root

USER 1001

# Job / CLI container — no EXPOSE
ENTRYPOINT ["python3"]
CMD ["-c", "import torch; print(f'triton-sigmoid v0.1.1 ready — PyTorch {torch.__version__}, CUDA available: {torch.cuda.is_available()}')"]
