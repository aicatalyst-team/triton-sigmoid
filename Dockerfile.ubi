# --------------------------------------------------------------------------- #
# Dockerfile.ubi — triton-sigmoid (GPU kernel library, job/CLI container)
# Base: NVIDIA CUDA 12.8 devel on UBI9 (Triton needs PTX/SASS compiler)
# --------------------------------------------------------------------------- #

FROM nvcr.io/nvidia/cuda:12.8.0-devel-ubi9 AS builder

USER 0

# ---- System dependencies -------------------------------------------------- #
RUN dnf install -y \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
    && dnf clean all

# Ensure python3 / pip3 point to 3.12
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

WORKDIR /opt/app-root/src

# ---- Install PyTorch with CUDA 12.8 support (separate step) -------------- #
# Use --extra-index-url so other packages still resolve from PyPI.
RUN python3 -m pip install --no-cache-dir \
        "torch>=2.6.0" \
        --extra-index-url https://download.pytorch.org/whl/cu128

# ---- Install triton (must be >=3.2.0) ------------------------------------- #
RUN python3 -m pip install --no-cache-dir "triton>=3.2.0"

# ---- Copy project source & install the library ---------------------------- #
COPY . .

RUN python3 -m pip install --no-cache-dir .

# ---- OpenShift: group-0 permissions for arbitrary UID --------------------- #
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root

USER 1001

ENTRYPOINT ["python3"]
CMD ["-c", "print('triton-sigmoid ready (v0.1.1) — pass a script or -c \"...\" to run GPU kernels')"]
