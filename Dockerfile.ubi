# --------------------------------------------------------------------------- #
# Dockerfile.ubi — triton-sigmoid (GPU kernel library, job/CLI container)
#
# Base: cuda:12.8.0-devel-ubi9 — devel variant supplies CUDA toolkit
# (ptxas, nvcc headers) that Triton needs for JIT-compiling GPU kernels.
# --------------------------------------------------------------------------- #

FROM nvcr.io/nvidia/cuda:12.8.0-devel-ubi9

USER 0

# ---- System dependencies -------------------------------------------------- #
RUN dnf install -y --nodocs --setopt=install_weak_deps=False \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey*

# Make python3 / pip point to 3.12
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Upgrade core packaging tools
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /opt/app-root/src

# ---- Install torch (largest dep) — separate layer for caching ------------ #
# --extra-index-url keeps PyPI available for torch's sub-dependencies while
# pulling the CUDA 12.8 wheel from the PyTorch index.
RUN python3 -m pip install --no-cache-dir \
        "torch>=2.6.0" \
        --extra-index-url https://download.pytorch.org/whl/cu128

# ---- Install triton — separate layer for caching ------------------------- #
RUN python3 -m pip install --no-cache-dir \
        "triton>=3.2.0"

# ---- Copy project source and install the library ------------------------- #
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/

# Install the project itself (--no-deps: torch/triton already installed)
# then install remaining light deps separately.
RUN python3 -m pip install --no-cache-dir --no-deps . \
    && python3 -m pip install --no-cache-dir numpy pandas

# ---- OpenShift: group-0 permissions for arbitrary UID --------------------- #
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root

USER 1001

# Job / CLI container — no EXPOSE
ENTRYPOINT ["python3"]
# NOTE: triton_sigmoid.__init__ requires a CUDA GPU at import time, so the
# default CMD only verifies torch is installed. On a GPU node, pass:
#   -c "import triton_sigmoid; print('ok')"
CMD ["-c", "import torch; print(f'triton-sigmoid container ready  |  PyTorch {torch.__version__}  |  CUDA available: {torch.cuda.is_available()}')"]
