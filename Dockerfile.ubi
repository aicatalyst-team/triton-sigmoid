# --------------------------------------------------------------------------- #
# Dockerfile.ubi — triton-sigmoid (GPU kernel library, job/CLI container)
# Base: NVIDIA CUDA 12.8 devel on UBI9 (Triton needs PTX/SASS at runtime)
# --------------------------------------------------------------------------- #
# Optimised for constrained OpenShift build environments:
#   - Each large pip install in its own layer with immediate cache cleanup
#   - torch installed alone (huge wheel) to keep peak disk low
#   - --no-cache-dir everywhere to avoid doubling disk usage
# --------------------------------------------------------------------------- #

FROM nvcr.io/nvidia/cuda:12.8.0-devel-ubi9

USER 0

# ---- System dependencies -------------------------------------------------- #
# Install Python 3.12 and minimal build tools in one layer.
RUN dnf install -y --nodocs --setopt=install_weak_deps=False \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey*

# Ensure python3 / pip3 point to 3.12
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Upgrade pip/setuptools/wheel in a slim layer before heavy installs
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /opt/app-root/src

# ---- Install torch first (largest dep, ~2.5 GB) in its own layer --------- #
# Separate layer avoids pip resolver loading all project deps at once.
# Using --index-url (not --extra-index-url) so pip resolves ONLY from the
# PyTorch CUDA wheel index for this step — much faster, no PyPI round-trips.
RUN python3 -m pip install --no-cache-dir \
        "torch>=2.6.0" \
        --index-url https://download.pytorch.org/whl/cu128 \
    && rm -rf /tmp/pip-* /root/.cache

# ---- Install triton in its own layer ------------------------------------- #
RUN python3 -m pip install --no-cache-dir \
        "triton>=3.2.0" \
    && rm -rf /tmp/pip-* /root/.cache

# ---- Copy project source and install the library ------------------------- #
COPY . .

# Install the project (numpy, pandas come from pyproject.toml dependencies).
# torch and triton are already satisfied from previous layers.
RUN python3 -m pip install --no-cache-dir --no-deps . \
    && python3 -m pip install --no-cache-dir numpy pandas \
    && rm -rf /tmp/pip-* /root/.cache

# ---- OpenShift: group-0 permissions for arbitrary UID --------------------- #
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root

USER 1001

# Job / CLI container — no EXPOSE
ENTRYPOINT ["python3"]
# NOTE: triton_sigmoid.__init__ requires CUDA at import time, so we only
# verify the supporting stack here; full import happens on a GPU node.
CMD ["-c", "import torch; print(f'triton-sigmoid v0.1.1 ready  |  PyTorch {torch.__version__}  |  CUDA available: {torch.cuda.is_available()}')"]
