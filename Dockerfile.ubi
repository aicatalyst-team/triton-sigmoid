# --------------------------------------------------------------------------- #
# Dockerfile.ubi — triton-sigmoid (GPU kernel library, job/CLI container)
#
# Base: cuda:12.6.3-base-ubi9 (~300 MB). Triton JIT-compiles PTX at RUNTIME
# on GPU nodes, so the build itself needs no CUDA dev headers. Triton ships
# its own bundled CUDA compiler (ptxas) inside its Python wheel.
# --------------------------------------------------------------------------- #

FROM nvcr.io/nvidia/cuda:12.6.3-base-ubi9

USER 0

# ---- System dependencies -------------------------------------------------- #
# Python 3.12, pip, and minimal C toolchain for any native extensions.
RUN dnf install -y --nodocs --setopt=install_weak_deps=False \
        python3.12 \
        python3.12-pip \
        python3.12-devel \
        gcc \
        gcc-c++ \
    && dnf clean all \
    && rm -rf /var/cache/dnf /var/log/dnf* /var/log/hawkey*

# Make python3 / pip3 point to 3.12
RUN alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1 \
    && alternatives --install /usr/bin/python  python  /usr/bin/python3.12 1

# Upgrade core packaging tools
RUN python3 -m pip install --no-cache-dir --upgrade pip setuptools wheel

WORKDIR /opt/app-root/src

# ---- Install torch (largest dep) in its own layer ------------------------ #
# Use --extra-index-url so pip can still reach PyPI for torch's own deps
# while pulling the CUDA wheel from the PyTorch index.
RUN python3 -m pip install --no-cache-dir \
        "torch==2.6.0" \
        --extra-index-url https://download.pytorch.org/whl/cu126 \
    && rm -rf /tmp/pip-* /root/.cache

# ---- Install triton in its own layer ------------------------------------- #
RUN python3 -m pip install --no-cache-dir \
        "triton>=3.2.0" \
    && rm -rf /tmp/pip-* /root/.cache

# ---- Copy project source and install the library ------------------------- #
# NOTE: LICENSE was previously excluded by .dockerignore — that has been fixed.
COPY pyproject.toml README.md LICENSE ./
COPY src/ src/

# --no-deps: torch, triton already installed; install only the project itself
# then install remaining light deps (numpy, pandas) separately.
RUN python3 -m pip install --no-cache-dir --no-deps . \
    && python3 -m pip install --no-cache-dir numpy pandas \
    && rm -rf /tmp/pip-* /root/.cache

# ---- OpenShift: group-0 permissions for arbitrary UID --------------------- #
RUN chgrp -R 0 /opt/app-root && chmod -R g=u /opt/app-root

USER 1001

# Job / CLI container — no EXPOSE
ENTRYPOINT ["python3"]
CMD ["-c", "import torch; print(f'triton-sigmoid v0.1.1 ready  |  PyTorch {torch.__version__}  |  CUDA available: {torch.cuda.is_available()}')"]
